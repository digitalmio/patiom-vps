{
	"name": "@patiom/demo",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter @patiom/client build && wrangler dev --port 4000",
		"fetch:data": "node scripts/fetch-swapi.ts",
		"build": "pnpm --filter @patiom/client build && wrangler deploy --dry-run --outdir=dist",
		"deploy": "pnpm --filter @patiom/client build && wrangler deploy",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@graphql-tools/schema": "^10.1.0",
		"@patiom/client": "workspace:*",
		"graphql": "^16.11.0",
		"graphql-yoga": "^5.22.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260820.1",
		"typescript": "^5.9.3",
		"wrangler": "^4.125.0"
	}
}