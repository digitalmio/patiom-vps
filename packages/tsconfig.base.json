{
	"compilerOptions": {
		// Module System
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "ES2022",
		
		// Type Checking
		"strict": true,
		"skipLibCheck": true,
		
		// Emit (disabled - apps will bundle the TS directly)
		"noEmit": true,
		
		// Interop
		"esModuleInterop": true,
		"isolatedModules": true,
		"allowSyntheticDefaultImports": true,
		
		// Type Declarations
		"types": ["node"]
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules"]
}
